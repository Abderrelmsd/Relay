<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RepositoryUrl>https://github.com/Abderrelmsd/Relay</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Abderrelmsd/Relay</PackageProjectUrl>
    <PackageId>Relay</PackageId>
    <Description>Persistent outbox for reliable async delivery: Wolverine enqueue handoff, then claiming, retry, circuit breaking, dead-lettering and per-key ordering owned by Relay.</Description>
    <RootNamespace>Relay</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="WolverineFx" Version="6.41.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />

  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Relay.Tests" />
  </ItemGroup>
</Project>
