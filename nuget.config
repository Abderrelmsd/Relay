<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/Abderrelmsd/index.json" />
  </packageSources>
  <!-- Set GITHUB_USER and GITHUB_TOKEN (a PAT with read:packages; write:packages to publish). -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <!-- Own packages come only from GitHub Packages, everything else from nuget.org (their ids are short and could clash with public packages). -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Cipher" />
      <package pattern="Wire" />
      <package pattern="Mesh" />
      <package pattern="Keep" />
      <package pattern="Bridge" />
      <package pattern="Pulse" />
      <package pattern="Bedrock" />
      <package pattern="Passport" />
      <package pattern="Chronicle" />
      <package pattern="Atrium" />
      <package pattern="Silo" />
      <package pattern="Relay" />
      <package pattern="Warden" />
      <package pattern="Signal" />
      <package pattern="Coin" />
      <package pattern="Tally" />
      <package pattern="Gate" />
      <package pattern="Settle" />
      <package pattern="Metronome" />
      <package pattern="Loom" />
      <package pattern="Weave" />
      <package pattern="Tunnel" />
      <package pattern="Ferry" />
      <package pattern="Cistern" />
      <package pattern="Strata" />
      <package pattern="Lens" />
      <package pattern="Compass" />
      <package pattern="Slate" />
      <package pattern="Kiln" />
      <package pattern="Portal" />
      <package pattern="Canvas" />
      <package pattern="Prism" />
      <package pattern="Babel" />
      <package pattern="Custody" />
      <package pattern="Bazaar" />
      <package pattern="Shield" />
      <package pattern="Sage" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
